    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/@zvec/**/*.node",
      "node_modules/@zvec/**/*.so",
      "node_modules/@deepseek-ai/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "public/skills/**/*"
    ],
