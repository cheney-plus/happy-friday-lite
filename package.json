    "electron:build": "node scripts/prebuild-install.mjs x64 && node scripts/prebuild-clean.mjs x64 && node scripts/fix-langgraph-sdk.mjs && vite build && electron-builder --linux --x64 --config.npmRebuild=false && node scripts/verify-packaged-native-modules.mjs x64 && node scripts/prebuild-install.mjs",
