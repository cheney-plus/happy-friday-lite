{
  "name": "happy-friday-lite",
  "version": "1.7.0",
  "description": "Happy Friday Lite - Electron + Vue3",
  "author": "Chen Jie <chenjie.plus@qq.com>",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "node scripts/prebuild-install.mjs x64 && node scripts/prebuild-clean.mjs x64 && vite build && electron-builder --linux --x64 && node scripts/prebuild-install.mjs",
    "electron:build:arm64": "node scripts/prebuild-install.mjs arm64 && node scripts/prebuild-clean.mjs arm64 && vite build && electron-builder --linux --arm64 && node scripts/prebuild-install.mjs",
    "electron:build:all": "npm run electron:build && npm run electron:build:arm64",
    "start": "electron .",
    "postinstall": "node scripts/fix-langgraph-sdk.mjs"
  },
  "dependencies": {
    "@langchain/community": "^1.1.28",
    "@langchain/core": "^1.1.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "@langchain/textsplitters": "^1.0.0",
    "@mozilla/readability": "^0.6.0",
    "@zvec/zvec": "^0.5.0",
    "adm-zip": "^0.5.17",
    "cheerio": "^1.2.0",
    "deepagents": "^1.10.5",
    "html-to-text": "^9.0.5",
    "mammoth": "^1.12.0",
    "marked": "^18.0.3",
    "officeparser": "^6.1.1",
    "pptxgenjs": "^4.0.1",
    "sql.js": "^1.14.1",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "@zvec/bindings-darwin-arm64": "^0.5.0",
    "@zvec/bindings-linux-arm64": "^0.5.0",
    "@zvec/bindings-linux-x64": "^0.5.0",
    "@zvec/bindings-win32-x64": "^0.5.0"
  },
  "devDependencies": {
    "@schedule-x/calendar": "^4.5.0",
    "@schedule-x/event-modal": "^4.5.0",
    "@schedule-x/events-service": "^4.5.0",
    "@schedule-x/theme-default": "^4.5.0",
    "@schedule-x/vue": "^4.1.0",
    "@somecat/epub-reader": "^0.1.11",
    "@tiptap/extension-bubble-menu": "^3.23.4",
    "@tiptap/extension-code-block-lowlight": "^3.23.4",
    "@tiptap/extension-color": "^3.23.4",
    "@tiptap/extension-highlight": "^3.23.4",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/extension-subscript": "^3.23.4",
    "@tiptap/extension-superscript": "^3.23.4",
    "@tiptap/extension-table": "^3.23.4",
    "@tiptap/extension-table-cell": "^3.23.4",
    "@tiptap/extension-table-header": "^3.23.4",
    "@tiptap/extension-table-row": "^3.23.4",
    "@tiptap/extension-task-item": "^3.23.4",
    "@tiptap/extension-task-list": "^3.23.4",
    "@tiptap/extension-text-align": "^3.23.4",
    "@tiptap/extension-text-style": "^3.23.4",
    "@tiptap/extension-typography": "^3.23.4",
    "@tiptap/extension-underline": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@tiptap/vue-3": "^3.23.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "electron": "^42.2.0",
    "electron-builder": "^25.1.8",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^1.0.0",
    "pdfjs-dist": "^6.0.227",
    "pinia": "^3.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "sass": "^1.99.0",
    "sharp": "^0.35.3",
    "vite": "^6.0.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.0",
    "vue-router": "^5.0.6",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.happyfriday.lite",
    "productName": "Happy Friday Lite",
    "icon": "build/icons/icon.png",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/@zvec/**/*.node",
      "node_modules/@zvec/**/*.so"
    ],
    "files": [
      "dist/**/*",
      "main.js",
      "preload.cjs",
      "src-electron/**/*",
      "public/skills/**/*",
      "python/requirements.txt",
      "node_modules/sql.js/dist/sql-wasm.js",
      "node_modules/sql.js/dist/sql-wasm.wasm",
      "node_modules/sql.js/package.json",
      "!node_modules/react-icons/**/*",
      "!node_modules/react/**/*",
      "!node_modules/react-dom/**/*",
      "!node_modules/officeparser/node_modules/@napi-rs/**/*",
      "!node_modules/officeparser/node_modules/pdfjs-dist/**/*",
      "!node_modules/tesseract.js/**/*",
      "!node_modules/@napi-rs/**/*",
      "!node_modules/sharp/**/*",
      "!node_modules/@img/**/*",
      "!node_modules/js-tiktoken/dist/**/*.cjs",
      "!node_modules/sql.js/dist/sql-asm*",
      "!node_modules/sql.js/dist/*debug*",
      "!node_modules/sql.js/dist/*browser*",
      "!node_modules/sql.js/dist/worker.*",
      "!node_modules/@zvec/**/*.md",
      "!node_modules/@zvec/**/LICENSE",
      "!node_modules/handlebars/**/*",
      "!node_modules/@langchain/classic/agents/**/*",
      "!node_modules/@langchain/classic/chains/**/*",
      "!node_modules/@langchain/classic/experimental/**/*",
      "!node_modules/@langchain/classic/retrievers/**/*",
      "!node_modules/@langchain/classic/evaluation/**/*",
      "!node_modules/@langchain/classic/memory/**/*",
      "!node_modules/@langchain/classic/output_parsers/**/*",
      "!node_modules/@langchain/classic/tools/**/*",
      "!node_modules/@langchain/classic/smith/**/*",
      "!node_modules/@langchain/classic/util/**/*",
      "!node_modules/@langchain/classic/stores/**/*",
      "!node_modules/@langchain/classic/storage/**/*",
      "!node_modules/@langchain/classic/callbacks/**/*",
      "!node_modules/@langchain/classic/chat_models/**/*",
      "!node_modules/@langchain/classic/load/**/*",
      "!node_modules/@langchain/classic/hub/**/*",
      "!node_modules/@langchain/classic/vectorstores/**/*",
      "!node_modules/@langchain/classic/embeddings/**/*",
      "!node_modules/@langchain/classic/schema/**/*",
      "!node_modules/@langchain/classic/dist/agents/**/*",
      "!node_modules/@langchain/classic/dist/chains/**/*",
      "!node_modules/@langchain/classic/dist/experimental/**/*",
      "!node_modules/@langchain/classic/dist/retrievers/**/*",
      "!node_modules/@langchain/classic/dist/evaluation/**/*",
      "!node_modules/@langchain/classic/dist/memory/**/*",
      "!node_modules/@langchain/classic/dist/output_parsers/**/*",
      "!node_modules/@langchain/classic/dist/tools/**/*",
      "!node_modules/@langchain/classic/dist/smith/**/*",
      "!node_modules/@langchain/classic/dist/util/**/*",
      "!node_modules/@langchain/classic/dist/stores/**/*",
      "!node_modules/@langchain/classic/dist/storage/**/*",
      "!node_modules/@langchain/classic/dist/callbacks/**/*",
      "!node_modules/@langchain/classic/dist/chat_models/**/*",
      "!node_modules/@langchain/classic/dist/load/**/*",
      "!node_modules/@langchain/classic/dist/hub/**/*",
      "!node_modules/@langchain/classic/dist/vectorstores/**/*",
      "!node_modules/@langchain/classic/dist/embeddings/**/*",
      "!node_modules/@langchain/classic/dist/schema/**/*",
      "!node_modules/@langchain/community/vectorstores/**/*",
      "!node_modules/@langchain/community/chat_models/**/*",
      "!node_modules/@langchain/community/llms/**/*",
      "!node_modules/@langchain/community/embeddings/**/*",
      "!node_modules/@langchain/community/retrievers/**/*",
      "!node_modules/@langchain/community/experimental/**/*",
      "!node_modules/@langchain/community/memory/**/*",
      "!node_modules/@langchain/community/storage/**/*",
      "!node_modules/@langchain/community/structured_query/**/*",
      "!node_modules/@langchain/community/graphs/**/*",
      "!node_modules/@langchain/community/agents/**/*",
      "!node_modules/@langchain/community/indexes/**/*",
      "!node_modules/@langchain/community/caches/**/*",
      "!node_modules/@langchain/community/stores/**/*",
      "!node_modules/@langchain/community/document_compressors/**/*",
      "!node_modules/@langchain/community/document_transformers/**/*",
      "!node_modules/@langchain/community/chains/**/*",
      "!node_modules/@langchain/community/load/**/*",
      "!node_modules/@langchain/community/load.cjs",
      "!node_modules/@langchain/community/load.d.cts",
      "!node_modules/@langchain/community/load.d.ts",
      "!node_modules/@langchain/community/load.js",
      "!node_modules/@langchain/community/dist/vectorstores/**/*",
      "!node_modules/@langchain/community/dist/chat_models/**/*",
      "!node_modules/@langchain/community/dist/llms/**/*",
      "!node_modules/@langchain/community/dist/embeddings/**/*",
      "!node_modules/@langchain/community/dist/retrievers/**/*",
      "!node_modules/@langchain/community/dist/experimental/**/*",
      "!node_modules/@langchain/community/dist/memory/**/*",
      "!node_modules/@langchain/community/dist/storage/**/*",
      "!node_modules/@langchain/community/dist/structured_query/**/*",
      "!node_modules/@langchain/community/dist/graphs/**/*",
      "!node_modules/@langchain/community/dist/agents/**/*",
      "!node_modules/@langchain/community/dist/indexes/**/*",
      "!node_modules/@langchain/community/dist/caches/**/*",
      "!node_modules/@langchain/community/dist/stores/**/*",
      "!node_modules/@langchain/community/dist/document_compressors/**/*",
      "!node_modules/@langchain/community/dist/document_transformers/**/*",
      "!node_modules/@langchain/community/dist/chains/**/*",
      "!node_modules/@langchain/community/dist/load/**/*",
      "!node_modules/@langchain/community/dist/document_loaders/web/**/*",
      "!node_modules/**/*.md",
      "!node_modules/**/*.map",
      "!node_modules/**/docs/**/*",
      "!node_modules/**/test/**/*",
      "!node_modules/**/tests/**/*",
      "!node_modules/**/__tests__/**/*",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.cts",
      "!node_modules/**/*.d.mts",
      "!node_modules/**/*.ts",
      "!node_modules/**/*.flow",
      "!node_modules/@langchain/openai/node_modules/openai/src/**/*",
      "!node_modules/@langchain/openai/node_modules/openai/beta/**/*",
      "!node_modules/@langchain/openai/node_modules/openai/realtime/**/*",
      "node_modules/langchain/dist/agents/tests/utils.js",
      "node_modules/langchain/dist/agents/tests/utils.cjs"
    ],
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US",
      "en-GB",
      "ja",
      "ko"
    ],
    "mac": {
      "icon": "build/icons/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": null
    },
    "win": {
      "icon": "build/icons/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "icon": "build/icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
